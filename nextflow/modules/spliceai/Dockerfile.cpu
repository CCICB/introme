# Dockerfile.cpu
FROM python:3.9-slim

# Set noninteractive mode and locale
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install system packages (note: no CUDA toolkit), and clean up apt caches
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        procps \
        wget \
        git && \
    apt-get -y upgrade && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip and install TensorFlow (CPU‑only) and SpliceAI
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir tensorflow-cpu

# Define build-time variable for SpliceAI commit
ARG SPLICEAI_REPO=https://github.com/donren-leung/SpliceAI
ARG SPLICEAI_COMMIT=3577e1823a607265064874102e63dcdca049b9d4

RUN pip install --no-cache-dir spliceai@git+${SPLICEAI_REPO}@${SPLICEAI_COMMIT}

LABEL version="v1.4-cpu"
