# Use NVIDIA’s CUDA runtime as the base image
FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

# Set environment variables for noninteractive apt and locale settings
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install essential packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-utils \
        wget \
        git && \
    apt-get -y upgrade && \
    rm -rf /var/lib/apt/lists/*

# Install Miniconda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh

# Update PATH to include conda
ENV PATH=/opt/conda/bin:$PATH

# Update conda, install Python 3.9, add channels, and clean up caches
RUN conda update -n base -c defaults conda -y && \
    conda install -y python=3.9 && \
    conda config --add channels bioconda && \
    conda clean -afy

# Upgrade pip and install TensorFlow (GPU-capable) and SpliceAI
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir tensorflow[and-cuda]

# Define build-time variable for SpliceAI commit
ARG SPLICEAI_COMMIT=23f46843d8fec47572e5d081e46e759f2914d714

RUN pip install --no-cache-dir spliceai@git+https://github.com/donren-leung/SpliceAI@${SPLICEAI_COMMIT}

ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}

LABEL version="v1.2-gpu"
