FROM anaconda/miniconda:26.9.4

# Set environment variables
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CONDA_PLUGINS_AUTO_ACCEPT_TOS=yes

ARG IMAGE_VERSION=2.0.1
ARG CONDA_ENV=introme
ARG PYTHON_VERSION=3.10
ARG TORCH_VERSION=2.12.1

ARG PANGOLIN_REPO=https://github.com/donren-leung/PangolinBatched/
ARG PANGOLIN_COMMIT=71cad1c2e53210662cde89f344e37ab143c80e62

# System tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        procps \
        wget \
        git && \
    rm -rf /var/lib/apt/lists/*

# Python + PyVCF
RUN conda create -y \
        --name "${CONDA_ENV}" \
        --override-channels \
        -c conda-forge \
        "python=${PYTHON_VERSION}" \
        pyvcf && \
    conda clean -afy

ENV PATH="/opt/miniconda3/envs/${CONDA_ENV}/bin:${PATH}"

# PyTorch CPU
RUN python -m pip install --no-cache-dir \
        "torch==${TORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu

# Pangolin dependencies
RUN python -m pip install --no-cache-dir \
        gffutils \
        biopython \
        pandas \
        pyfastx

# Install Pangolin and retain its DB-generation script
RUN git init /tmp/pangolin && \
    cd /tmp/pangolin && \
    git remote add origin "${PANGOLIN_REPO}" && \
    git fetch --depth 1 origin "${PANGOLIN_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    python -m pip install --no-cache-dir . && \
    mkdir -p /opt/introme/bin && \
    install -m 0755 scripts/create_db.py /opt/introme/bin/create_pangolin_db.py && \
    rm -rf /tmp/pangolin

# Final sanity checks
RUN python -c "\
import torch; \
print('torch:', torch.__version__); \
assert torch.version.cuda is None" && \
    python /opt/introme/bin/create_pangolin_db.py --help >/dev/null && \
    python -m pip check

LABEL org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.source="https://github.com/CCICB/introme" \
      org.ccicb.introme.runtime="cpu" \
      org.ccicb.introme.python.version="${PYTHON_VERSION}" \
      org.ccicb.introme.torch.version="${TORCH_VERSION}" \
      org.ccicb.introme.pangolin.source="${PANGOLIN_REPO}" \
      org.ccicb.introme.pangolin.commit="${PANGOLIN_COMMIT}"
