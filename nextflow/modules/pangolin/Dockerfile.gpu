ARG CUDA_VERSION=12.6.3
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

# Re-declare ARGs after FROM so they are available in this build stage
ARG CUDA_VERSION
ARG UBUNTU_VERSION

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CONDA_PLUGINS_AUTO_ACCEPT_TOS=yes

ARG IMAGE_VERSION=2.0.0
ARG CONDA_ENV=introme
ARG PYTHON_VERSION=3.10
ARG TORCH_VERSION=2.12.1
ARG TORCH_CUDA_INDEX=cu126

ARG MINICONDA_INSTALLER=Miniconda3-py310_26.9.4-0-Linux-x86_64.sh
ARG MINICONDA_SHA256=258005644606ee77d2ed31bcff9dd14975885f601a1fd55d06e4628d0a047f89

ARG PANGOLIN_REPO=https://github.com/donren-leung/PangolinBatched/
ARG PANGOLIN_COMMIT=71cad1c2e53210662cde89f344e37ab143c80e62

# System tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        git && \
    rm -rf /var/lib/apt/lists/*

# Install Miniconda
RUN wget --quiet \
        "https://repo.anaconda.com/miniconda/${MINICONDA_INSTALLER}" \
        -O /tmp/miniconda.sh && \
    echo "${MINICONDA_SHA256}  /tmp/miniconda.sh" | sha256sum -c - && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda3 && \
    rm /tmp/miniconda.sh

ENV PATH="/opt/miniconda3/bin:${PATH}"

# Python + PyVCF
RUN conda create -y \
        --name "${CONDA_ENV}" \
        --override-channels \
        -c conda-forge \
        "python=${PYTHON_VERSION}" \
        pyvcf && \
    conda clean -afy

ENV PATH="/opt/miniconda3/envs/${CONDA_ENV}/bin:${PATH}"

# PyTorch GPU build
RUN python -m pip install --no-cache-dir \
        "torch==${TORCH_VERSION}" \
        --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}"

# Pangolin dependencies
RUN python -m pip install --no-cache-dir \
        gffutils \
        biopython \
        pandas \
        pyfastx

# Install Pangolin and retain its DB-generation script
RUN git init /tmp/pangolin && \
    cd /tmp/pangolin && \
    git remote add origin "${PANGOLIN_REPO}" && \
    git fetch --depth 1 origin "${PANGOLIN_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    python -m pip install --no-cache-dir . && \
    mkdir -p /opt/introme/bin && \
    install -m 0755 scripts/create_db.py /opt/introme/bin/create_pangolin_db.py && \
    rm -rf /tmp/pangolin

# NVIDIA runtime library paths
ENV LD_LIBRARY_PATH="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}"

# Build-time sanity checks
RUN python -c "\
import torch; \
print('torch:', torch.__version__); \
print('torch CUDA build:', torch.version.cuda); \
assert torch.version.cuda is not None" && \
    python /opt/introme/bin/create_pangolin_db.py --help >/dev/null && \
    python -m pip check

LABEL org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.source="https://github.com/CCICB/introme" \
      org.ccicb.introme.runtime="gpu" \
      org.ccicb.introme.python.version="${PYTHON_VERSION}" \
      org.ccicb.introme.torch.version="${TORCH_VERSION}" \
      org.ccicb.introme.torch.cuda="${TORCH_CUDA_INDEX}" \
      org.ccicb.introme.cuda.base="${CUDA_VERSION}" \
      org.ccicb.introme.pangolin.source="${PANGOLIN_REPO}" \
      org.ccicb.introme.pangolin.commit="${PANGOLIN_COMMIT}"
