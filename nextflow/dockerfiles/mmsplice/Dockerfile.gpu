FROM anaconda/miniconda:26.9.4

# Set environment variables
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CONDA_PLUGINS_AUTO_ACCEPT_TOS=yes

ARG IMAGE_VERSION=3.0.0
ARG CONDA_ENV=introme
ARG PYTHON_VERSION=3.10
ARG TF_VERSION=2.15.1
ARG TF_CUDA_VERSION=12.2
ARG NUMPY_VERSION=1.26.4
ARG CYVCF2_VERSION=0.30.15
ARG SETUPTOOLS_VERSION=80.10.2


ARG MMSPLICE_REPO=https://github.com/gagneurlab/MMSplice_MTSplice.git
ARG MMSPLICE_VERSION=2.4.0
ARG MMSPLICE_COMMIT=31513da3846b187b3d7f96ad14f3c71e1177b0d3

WORKDIR /app

# System tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        procps \
        git && \
    rm -rf /var/lib/apt/lists/*

# Python environment
RUN conda create -y \
        --name "${CONDA_ENV}" \
        --override-channels \
        -c conda-forge \
        "python=${PYTHON_VERSION}" \
        pip && \
    conda clean -afy

ENV PATH="/opt/miniconda3/envs/${CONDA_ENV}/bin:${PATH}"

# TensorFlow + explicitly pinned key dependencies
RUN python -m pip install --no-cache-dir \
        "tensorflow[and-cuda]==${TF_VERSION}" \
        "numpy==${NUMPY_VERSION}" \
        "cyvcf2==${CYVCF2_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        cython \
        pybigwig

# Fix writeVCF IndexError: index 0 is out of bounds for axis 0 with size 0
# MMSplice 2.4.0 depends on pyranges, which depends on native extensions
# such as ncls and sorted_nearest, which is why we tmp install build-essential
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential && \
    git init /tmp/mmsplice && \
    cd /tmp/mmsplice && \
    git remote add origin "${MMSPLICE_REPO}" && \
    git fetch --depth 1 origin "${MMSPLICE_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    grep -Fq 'if pred is not None:' mmsplice/utils.py && \
    sed -i 's/if pred is not None:/if (pred is not None and len(pred.index) > 0 ):/' /tmp/mmsplice/mmsplice/utils.py && \
    grep -Fq "'tensorflow'," setup.py && \
    sed -i \
        "s/'tensorflow',/'tensorflow==${TF_VERSION}',/" \
        setup.py && \
    \
    python -m pip install --no-cache-dir . && \
    rm -rf /tmp/mmsplice && \
    apt-get purge -y --auto-remove build-essential && \
    rm -rf /var/lib/apt/lists/*

# Introme MMSplice wrapper
COPY --chmod=0755 run_mmsplice.py /usr/local/bin/run_mmsplice.py

RUN python -c "\
import tensorflow as tf; \
import numpy as np; \
import mmsplice; \
build = tf.sysconfig.get_build_info(); \
print('tensorflow:', tf.__version__); \
print('numpy:', np.__version__); \
print('mmsplice:', mmsplice.__version__); \
print('TensorFlow build info:', build); \
print('CUDA build:', build.get('is_cuda_build')); \
print('CUDA version:', build.get('cuda_version')); \
print('cuDNN version:', build.get('cudnn_version')); \
assert tf.__version__ == '${TF_VERSION}'; \
assert np.__version__ == '${NUMPY_VERSION}'; \
assert mmsplice.__version__ == '${MMSPLICE_VERSION}'; \
assert build.get('is_cuda_build') is True; \
assert build.get('cuda_version') == '${TF_CUDA_VERSION}'" && \
    python -m pip check && \
    command -v run_mmsplice.py

LABEL org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.source="https://github.com/CCICB/introme" \
      org.ccicb.introme.runtime="gpu" \
      org.ccicb.introme.python.version="${PYTHON_VERSION}" \
      org.ccicb.introme.tensorflow.version="${TF_VERSION}" \
      org.ccicb.introme.tensorflow.cuda="${TF_CUDA_VERSION}" \
      org.ccicb.introme.numpy.version="${NUMPY_VERSION}" \
      org.ccicb.introme.cyvcf2.version="${CYVCF2_VERSION}" \
      org.ccicb.introme.setuptools.version="${SETUPTOOLS_VERSION}" \
      org.ccicb.introme.mmsplice.source="${MMSPLICE_REPO}" \
      org.ccicb.introme.mmsplice.commit="${MMSPLICE_COMMIT}"
