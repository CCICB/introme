params {
    vcf = "test.vcf"
    ref_genome = "hg38.fa"
    gtf = "gencode.v44.annotation.gtf.gz"
    genome_build = "hg38"
    prefix = "introme_test"
    bed = ""
    quality_filter = true
    allele_frequency = 0.01
    
    chrRename = "$projectDir/assets/chrRename.tsv"
    outdir = "./output"
}


docker {
    enabled = true
}


plugins {
  id 'nf-validation@0.2.1'
}


profiles {
    // CPU-only profile (default)
    standard {
        process.executor = 'local'
        docker {
            enabled = true
        }

        // If you have 23GB to spare :))
        params {
            spliceai_docker_container = params.spliceai_cpu_docker_container
            spliceai_cpus = 8
            spliceai_mem = '8 GB'

            pangolin_docker_container = params.pangolin_cpu_docker_container
            pangolin_cpus = 8
            pangolin_mem = '2 GB'

            mmsplice_docker_container = params.mmsplice_cpu_docker_container
            mmsplice_cpus = 8
            mmsplice_mem = '8 GB'

            spip_cpus = 1
            spip_mem = '4 GB'

            spliceogen_cpus = 3
            spliceogen_mem = '1 GB'
        }
    }

    // GPU-enabled profile: Only processes with the 'gpu' label will get GPU run options.
    // If you have 23GB to spare :))
    gpu {
        process.executor = 'local'
        docker {
            enabled = true
        }
        params {
            spliceai_docker_container = params.spliceai_gpu_docker_container
            spliceai_cpus = 1
            spliceai_mem = '8 GB'

            pangolin_docker_container = params.pangolin_gpu_docker_container
            pangolin_cpus = 1
            pangolin_mem = '2 GB'

            mmsplice_docker_container = params.mmsplice_gpu_docker_container
            mmsplice_cpus = 1
            mmsplice_mem = '8 GB'

            spip_cpus = 1
            spip_mem = '4 GB'

            spliceogen_cpus = 3
            spliceogen_mem = '1 GB'
        }
    }
}

// Global process configuration: apply GPU runOptions only to processes labeled 'gpu'
process {
    withLabel('gpu') {
         docker.runOptions = '--gpus all'
    }
}
